# Copy to .env and fill in your key:  cp .env.example .env
# Free NVIDIA NIM key (starts with nvapi-): https://build.nvidia.com
LLM_API_KEY=your_nvidia_api_key_here

# Any OpenAI-compatible endpoint works. Default: Nemotron 3 Nano on NVIDIA NIM (open weights, MoE with ~3B active
# parameters, native tool calling). Alternatives (use that provider's key):
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-20b
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# gpt-oss only: keep hidden reasoning short (fewer tokens, fewer rate-limit waits)
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.2
# Output budget per call (reply + tool-call JSON + any reasoning); too low cuts tool calls off
LLM_MAX_TOKENS=4096
# Hybrid-reasoning models (NVIDIA Nemotron, Qwen3): off | on forces chat_template_kwargs.enable_thinking;
# leave empty for the model default. Reasoning is never shown to guests either way.
LLM_THINKING=

# Optional
# GOODFOODS_DB=data/goodfoods.db
# GOODFOODS_TZ=Asia/Kolkata
# AGENT_MAX_STEPS=6
